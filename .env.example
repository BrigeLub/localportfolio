# Copy to .env and fill in. Never commit .env.

# --- database ---
# Railway injects this automatically when a Postgres service is attached.
# Locally: `docker compose up -d` and use the line below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/portfolio

# --- admin login ---
# Generate with: npm run hash-password -- "the password"
ADMIN_PASSWORD_HASH=
# Any long random string. Rotating it signs every admin session out.
SESSION_SECRET=

# --- image storage ---
# On Railway, mount the volume at /data and set this to /data/uploads.
# Defaults to ./uploads locally if unset.
UPLOAD_DIR=
